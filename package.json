{
  "name": "com.bunkerpalace.cordova.YoutubeVideoPlayer",
  "version": "1.0.5",
  "description": "Play Youtube Videos in a native Video Player on Android & iOS.",
  "cordova": {
    "id": "com.bunkerpalace.cordova.YoutubeVideoPlayer",
    "platforms": [
      "android",
      "ios"
    ]
  },
  "engines": {
    "cordovaDependencies": {}
  },
  "scripts": {
    "test": "jest --coverage",
    "lint": "eslint \"plugins/**/www/*.{js,ts}\" \"www/**/*.{js,ts}\"",
    "format": "prettier --check \"plugins/**/www/*.{js,ts}\" \"www/**/*.{js,ts}\"",
    "format:fix": "prettier --write \"plugins/**/www/*.{js,ts}\" \"www/**/*.{js,ts}\"",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cordova-android": "^15.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  }
}
